# AgentHub BFF 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
#   cp .env.example .env

# ---- 搜索 API Key（至少配一个，推荐 SearchAPI） ----

# SearchAPI.io（支持百度/Google/Bing，推荐国内使用）
SEARCHAPI_API_KEY=你的SearchAPI_Key
# 搜索引擎，默认 baidu；可选 google / bing
# SEARCHAPI_ENGINE=baidu

# Brave Search API
# BRAVE_SEARCH_API_KEY=

# Tavily Search API
# TAVILY_API_KEY=

# ---- LLM API Key（用于任务拆解等） ----

# OpenAI（Codex adapter）
# OPENAI_API_KEY=

# Anthropic（Claude adapter）
# ANTHROPIC_API_KEY=
