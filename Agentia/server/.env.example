# AgentHub BFF 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
#   cp .env.example .env

# ---- 搜索 API Key（至少配一个，推荐 SearchAPI） ----

# SearchAPI.io（支持百度/Google/Bing，推荐国内使用）
SEARCHAPI_API_KEY=你的SearchAPI_Key
# 搜索引擎，默认 baidu；可选 google / bing
# SEARCHAPI_ENGINE=baidu

# Brave Search API
# BRAVE_SEARCH_API_KEY=

# Tavily Search API
# TAVILY_API_KEY=

# ---- LLM API Key（用于任务拆解等） ----

# OpenAI（Codex adapter）
# OPENAI_API_KEY=

# Anthropic（Claude adapter）
# ANTHROPIC_API_KEY=

# ---- Netlify 静态站点部署 ----
# Netlify Personal Access Token，用于“部署”按钮将前端 Agent 生成的 HTML 页面发布到 Netlify
NETLIFY_AUTH_TOKEN=
# 可选：复用已有 Netlify 站点；不填则自动创建新站点
NETLIFY_SITE_ID=
# 可选：自动创建站点时使用的站点名
NETLIFY_SITE_NAME=
